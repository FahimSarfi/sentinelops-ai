# Supabase project URL and public publishable key (never use a service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Demo is enabled locally. Explicitly opt in for a hosted demo.
DEMO_ACCESS_ENABLED=false
# Required for stable demo sessions across server restarts; at least 32 characters.
AUTH_SESSION_SECRET=
# Optional server-only read access to the isolated local backend.
# Only loopback hosts are supported. No repairs are exposed by the frontend.
SENTINELOPS_API_URL=http://127.0.0.1:8000
