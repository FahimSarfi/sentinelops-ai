# Public, NONPRODUCTION demo values only. Copy to ignored .env.
POSTGRES_USER=sentinelops_demo
POSTGRES_PASSWORD=local_demo_only_change_me
POSTGRES_DB=sentinelops_demo

# Real tool-calling model; no key is supplied with the repository.
SENTINELOPS_MODEL=
SENTINELOPS_MODEL_API_KEY=
SENTINELOPS_MODEL_BASE_URL=https://api.openai.com/v1
# Optional private local state path; default shown here.
SENTINELOPS_STATE_PATH=.sentinelops/incidents.sqlite3

# Neatlogs Project API key (not the nlw_ HTTP ingest key). Never commit a real key.
NEATLOGS_API_KEY=
# Use eu.ingest.neatlogs.com:443 for an EU project.
NEATLOGS_OTLP_ENDPOINT=ingest.neatlogs.com:443
